run = "pip install -q -r bridge_db/requirements.txt && cd bridge_db && streamlit run app.py --server.port $PORT --server.address 0.0.0.0 --server.headless true --browser.gatherUsageStats false"
language = "python3"

[nix]
channel = "stable-22_11"

[deployment]
run = ["sh", "-c", "pip install -q -r bridge_db/requirements.txt && cd bridge_db && streamlit run app.py --server.port $PORT --server.address 0.0.0.0 --server.headless true --browser.gatherUsageStats false"]
